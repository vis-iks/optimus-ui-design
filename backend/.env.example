# --- Database -------------------------------------------------------------
# Local dev: a file in the backend directory. In production point this at a
# path on a PERSISTENT volume, e.g. sqlite:////data/themes.db
DATABASE_URL=sqlite:///./themes.db

# --- GitHub OAuth app ---------------------------------------------------
# Create one at https://github.com/settings/developers
#   Homepage URL:               http://localhost:4200
#   Authorization callback URL: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# --- Frontend ---------------------------------------------------------------
# Where the browser is sent back to after login (the SPA origin).
FRONTEND_URL=http://localhost:4200
# Comma-separated list of origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:4200

# --- Security -------------------------------------------------------------
# Used to sign session + OAuth-state JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-change-me

# --- Marketplace policy ------------------------------------------------
# Comma-separated GitHub logins that get admin (report moderation) rights.
ADMIN_GITHUB_LOGINS=
# Max serialized size of a submitted preset, in bytes (default 256 KiB).
MAX_PRESET_BYTES=262144
# Max themes a single user may own.
USER_THEME_QUOTA=50
# A theme is auto-hidden once it reaches this many distinct reports.
AUTO_HIDE_REPORT_THRESHOLD=3
